# Gemeinsame Datenbank (Supabase) – optional.
# Ohne diese Werte läuft die App rein lokal mit Export/Import.
# Anleitung: docs/SUPABASE_PLAN.md
#
# Beide Werte sind öffentlich (sie landen im ausgelieferten JavaScript).
# Der Schutz der Daten liegt in den Zugriffsregeln der Datenbank (RLS).
# NIEMALS den service_role-Key hier eintragen.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
